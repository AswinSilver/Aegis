# Run from the project root with: uvicorn app.main:app --app-dir backend --reload
DATABASE_URL=sqlite:///./data/blacksite.db
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BYTES=26214400
MAX_TEXT_BYTES=20971520
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=240
EXTERNAL_REQUEST_TIMEOUT_SECONDS=5

# Optional provider credentials. Leave blank for offline/local-only behavior.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_URL=
URLHAUS_ENABLED=false
NVD_API_KEY=
# NVD's public endpoint is enabled by default; set this to false for offline-only mode.
NVD_ENABLED=true
